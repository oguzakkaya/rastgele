# OpenAI anahtarı. Boş bırakılırsa uygulama hazır konularla (fallback modu) çalışır.
OPENAI_API_KEY=

# Kullanılacak model (varsayılan: gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini

# OpenAI istek zaman aşımı (ms)
OPENAI_TIMEOUT_MS=20000

# 1 yapılırsa anahtar olsa bile AI kapatılır (testler için)
RASTGELE_DISABLE_AI=

# Canonical URL, sitemap ve Open Graph için
NEXT_PUBLIC_SITE_URL=http://localhost:3000
