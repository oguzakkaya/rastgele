# OpenAI key. Leave empty to run on the prepared topics (fallback mode).
OPENAI_API_KEY=

# Model to use (default: gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini

# OpenAI request timeout (ms)
OPENAI_TIMEOUT_MS=20000

# Set to 1 to disable AI even when a key is present (used by tests)
RASTGELE_DISABLE_AI=

# Canonical URL for the sitemap and Open Graph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000
